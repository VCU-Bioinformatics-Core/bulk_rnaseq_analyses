/*
 * bisrDE Nextflow configuration. Phase 6.1.
 *
 * Three profiles:
 *   - local:     run with local R (requires bisrDE installed in user lib
 *                or accessible via devtools::load_all from the parent dir
 *                — same logic the de.R wrapper uses).
 *   - container: run inside the dge_analysis.sif Apptainer container,
 *                which bundles bisrDE + Quarto + all R deps. Phase 8 will
 *                rebuild this container with the Phase 5.9 install steps.
 *   - slurm:     submit to a SLURM cluster. Combine with `-profile container,slurm`.
 */

manifest {
    name            = 'bisrDE'
    author          = 'Mikail Bala'
    homePage        = 'https://github.com/VCUMasseyBISR/bisrDE'
    description     = 'Bulk RNA-Seq Differential Expression Pipeline (DSL2 wrapper around the bisrDE R package)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10'
    version         = '1.5.0-dev'
}

// Parameter defaults — set here so they are visible to all process scopes.
// Setting `params.foo = ...` at the top of main.nf is NOT equivalent — those
// assignments don't always propagate to processes that reference them via
// `${params.foo}`. Defining them in `params {}` here is the canonical pattern.
params {
    counts             = null
    samplesheet        = null
    outdir             = './results'
    runid              = null
    annotation         = 'mouse'
    brs_ticket         = ''
    id_type            = 'ensembl'
    // v1.5.0 — sample/group/contrast selection (comma-separated). Empty = no filtering.
    exclude_samples    = ''
    exclude_groups     = ''
    include_contrasts  = ''
    exclude_contrasts  = ''
    help               = false
}

// Default reporting / tracing — file paths are computed at runtime via
// closures so they pick up params.outdir after CLI args are parsed.
report {
    enabled   = true
    file      = { "${params.outdir}/nextflow_report.html" }
    overwrite = true
}

trace {
    enabled   = true
    file      = { "${params.outdir}/nextflow_trace.txt" }
    overwrite = true
}

profiles {
    local {
        process.executor = 'local'
        // No container; processes run in the host R env.
    }

    container {
        process.executor = 'local'
        apptainer {
            enabled    = true
            autoMounts = true
        }
        // Container image is co-located with the parent project.
        process.container = "${projectDir}/../dge_analysis.sif"
    }

    slurm {
        process.executor = 'slurm'
        // Sensible defaults; users override via -c custom.config.
        process {
            cpus    = 4
            memory  = '16 GB'
            time    = '2 h'
            queue   = 'short'
        }
    }
}

